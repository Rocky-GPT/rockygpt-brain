# Trusted server identity; never supplied by a chat client.
BRAIN_ENVIRONMENT=development
# Dedicated OpenAI project/key for ONLY this environment.
BRAIN_OPENAI_API_KEY=
BRAIN_OPENAI_PROJECT=
# Optional Jev routing. Keep off until the routing evaluation gates pass.
# Allowed modes: off, shadow, active. Both shadow and active incur paid calls.
BRAIN_ROUTING_MODE=off
BRAIN_TYPESAFE_API_KEY=
# Separate operational connection, granted ONLY brain_development (or brain_production).
BRAIN_LEDGER_DATABASE_URL=
# Optional deployment pin: python -m rockygpt_brain.config
BRAIN_EXPECTED_CONFIG_HASH=
# Campus retrieval stays on its own read-only connection.
DATABASE_URL=
# Optional: shared with the UI and Dev proxy for protected environments.
STAGING_SERVICE_TOKEN=
