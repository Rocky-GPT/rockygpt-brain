APP_ENV=development
HOST=127.0.0.1
PORT=8000

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Shared with the production brain so /logs can show both client and dev turns.
DATABASE_URL=
# Use the same 32+ character value in every process that writes shared logs.
CHAT_LOG_HASH_KEY=

# Optional local/admin compatibility values.
ADMIN_API_TOKEN=
STAGING_SERVICE_TOKEN=
ADMIN_ENABLED=true
DATA_URL=http://127.0.0.1:8100
RAG_ENABLED=false
OPENAI_WEB_MODEL=gpt-4.1-mini
