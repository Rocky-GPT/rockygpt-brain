# Trusted server identity: development or production. Picks the spending allowance.
BRAIN_ENVIRONMENT=development
# Read-only campus data access: active release, campus identities, linked contacts.
DATABASE_URL=
# The spending ledger. A login granted ONLY brain_development (or brain_production).
BRAIN_LEDGER_DATABASE_URL=
# Environment-specific OpenAI project and key. Never accept these from chat requests.
BRAIN_OPENAI_API_KEY=
BRAIN_OPENAI_PROJECT=
# Shared with the UI and Dev proxy. Required in production; optional in development.
STAGING_SERVICE_TOKEN=

# Model and rates default to the verified provider-release.json, which has an expiry.
# Override all four together, using verified prices in nano-dollars per token:
# BRAIN_OPENAI_MODEL=
# BRAIN_OPENAI_INPUT_NUSD_PER_TOKEN=
# BRAIN_OPENAI_OUTPUT_NUSD_PER_TOKEN=
# BRAIN_OPENAI_PRICE_VALID_UNTIL=  # timezone-aware ISO timestamp
# Optional with a complete override; omitted cached rate conservatively equals input.
# BRAIN_OPENAI_CACHED_INPUT_NUSD_PER_TOKEN=

# Optional execution ceilings (not increases to the durable monthly allowance).
# BRAIN_MAX_INPUT_BYTES=100000
# BRAIN_MAX_OUTPUT_TOKENS=1200
# BRAIN_MAX_TURN_NUSD=25000000
