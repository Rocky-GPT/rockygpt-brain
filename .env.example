# Runtime
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Model access. Never commit a real value.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Brain-owned persistence. This credential must not have access to the data
# service's schema.
DATABASE_URL=postgres://rockygpt_brain:rockygpt_brain@127.0.0.1:5432/rockygpt

# The only supported route to campus data is this HTTP origin.
DATA_URL=http://127.0.0.1:8100

# Independent secrets. Generate local values with: openssl rand -hex 32
CHAT_LOG_HASH_KEY=
ADMIN_API_TOKEN=

# This value must exactly match the server-side value in rockygpt-ui and must
# contain at least 32 characters. It is never exposed to browser code.
ABUSE_HASH_KEY=

# Staging only. Leave blank locally and unset in production.
STAGING_SERVICE_TOKEN=
